    updateSpeakerInfo: 0
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 0}
  - isEndpoint: 0
    id: 3
    nextNodeID: 4
    text: Let me travel safely from this place and make my way to another land,
