    updateSpeakerInfo: 0
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 0}
  - isEndpoint: 0
    id: 5
    nextNodeID: 6
    text: I will ever remember you and give you gratitude in my prayers,
