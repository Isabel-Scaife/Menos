  startingNodeID: 0
  nodes:
  - isEndpoint: 0
    id: 0
    nextNodeID: 1
    text: 'This is... Mother''s brooch. The very brooch Father gave her, the one
      she held most dear. '
    choices: []
    updateSpeakerInfo: 1
