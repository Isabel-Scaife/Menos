  startingNodeID: 0
  nodes:
  - isEndpoint: 0
    id: 0
    nextNodeID: Selection
    text: Have you figured out the culprit, boy? You'll have to pick wisely. The
      consequences would be dire.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
