  - isEndpoint: 0
    id: Selection
    nextNodeID: 
    text: 
    choices:
    - text: I'm confident that I've figured it out.
      nextNodeID: Culprit
      outcome:
        completionEvents: []
    - text: Actually, I would appreciate more time to think.
      nextNodeID: End
      outcome:
        completionEvents: []
