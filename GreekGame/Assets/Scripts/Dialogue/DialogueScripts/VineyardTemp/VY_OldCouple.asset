  - isEndpoint: 0
    id: CryingChild
    nextNodeID: EndOfConvo
    text: Oh dear, I think one of our patients need our attention, Sozon. We'd love
      to help you more, dear, but I'm sorry.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Phila
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
