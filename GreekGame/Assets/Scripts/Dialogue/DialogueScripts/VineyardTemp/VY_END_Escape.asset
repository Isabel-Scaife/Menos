  - isEndpoint: 0
    id: 1
    nextNodeID: 2
    text: 'Alcippe...? She thinks I killed Mother... '
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 0}
  - isEndpoint: 0
    id: 2
    nextNodeID: 3
    text: 'No... she''d never believe me. Not after everything... and not while I''m
      holding Mother''s brooch. '
    choices: []
    updateSpeakerInfo: 0
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 0}
  - isEndpoint: 1
