  m_Name: VY_OliveFarmer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  startingNodeID: Greeting
  nodes:
  - isEndpoint: 0
    id: Greeting
    nextNodeID: Job
    text: Greetings, fair traveler. If I had time to spare, I would engage in a conversation
      with you, but I don't.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Trophimus
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Job
    nextNodeID: NotDone
    text: 'Oh, I''m not here to bother you. I''m here to fullfil my duty of picking
      up olives on behalf of Master Cranaus. '
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: NotDone
    nextNodeID: Offer
    text: 'You must be from the post office. I''m sorry, but you''ll have to wait
      - I''m not done harvesting them. '
    choices: []
    updateSpeakerInfo: 1
    speakerName: Trophimus
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Offer
    nextNodeID: 
    text: 'I''d like to help you harvest because that way we can get work done quicker
      together. Besides, I would be wasting my time if I were to sit down and wait. '
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 1
    id: Appreciated
    nextNodeID: 
    text: 'You have such a kind heart. If you go over to the olive tree and start
      helping me bring in the harvest, you would have my utmost gratitude. '
    choices: []
    updateSpeakerInfo: 1
    speakerName: Trophimus
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
