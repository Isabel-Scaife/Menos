  - isEndpoint: 0
    id: choices0
    nextNodeID: 
    text: 
    choices:
    - text: 'You''re crying, kid. Are you alright? '
      nextNodeID: No
      outcome:
        flagsToSet: []
        statChanges: 
        questsID: []
    - text: It hurts me to see you cry. Anything I can do to help?
      nextNodeID: No
      outcome:
        flagsToSet: []
        statChanges: 
        questsID: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
