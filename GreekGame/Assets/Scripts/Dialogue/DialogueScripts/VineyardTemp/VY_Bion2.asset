  - isEndpoint: 0
    id: Job
    nextNodeID: choices1
    text: I just need a stable job to support my family.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Bion
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: choices1
    nextNodeID: 
    text: 
    choices:
    - text: How did you get hurt?
      nextNodeID: Clue1
      outcome:
        flagsToSet: []
        statChanges: 
        questsID: []
    - text: "No problem. You should have lunch. Your wound isn\u2019t going to heal
