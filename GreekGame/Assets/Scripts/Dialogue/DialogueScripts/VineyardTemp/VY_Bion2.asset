  - isEndpoint: 0
    id: Thanks
    nextNodeID: Job
    text: "\u2026But thanks for helping my grandma."
    choices: []
    updateSpeakerInfo: 0
    speakerName: Bion
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
