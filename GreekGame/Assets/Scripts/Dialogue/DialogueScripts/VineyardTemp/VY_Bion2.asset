  - isEndpoint: 0
    id: Whimper
    nextNodeID: choices0
    text: ..Ow. It still hurts. Why... why is everything... so hard?
    choices: []
    updateSpeakerInfo: 1
    speakerName: Bion
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
