  startingNodeID: No
  nodes:
  - isEndpoint: 0
    id: No
    nextNodeID: Past0
    text: Blast! I have cut down the vines a week ago in preparation, but it grown
      so fast to cover up the shed again!
    choices: []
    updateSpeakerInfo: 1
    speakerName: Damasos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Past0
    nextNodeID: Past1
    text: 'A few years ago, a red haired girl with quite some temper helped me cut
      this vines - she would do it in no time. '
    choices: []
    updateSpeakerInfo: 1
    speakerName: Damasos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Past1
    nextNodeID: Help
    text: But she disappeared suddenly... just like how she appeared to this village
      suddenly.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Damasos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Help
    nextNodeID: OfCourse
    text: Can you please help me cut these down? Here, I have a spare axe for you
      to use.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Damasos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
