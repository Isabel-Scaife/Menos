  m_Script: {fileID: 11500000, guid: 8cea624aa6e51a74d85663bcdeb0ee41, type: 3}
  m_Name: VY_WheatFarmer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  startingNodeID: Hello
  nodes:
  - isEndpoint: 0
    id: Hello
    nextNodeID: Struggle
    text: "I\u2019m a delivery man from Lord Cranaus. I came to pick up some of the
      wheat that our post office ordered. "
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Struggle
    nextNodeID: Sigh
    text: "Here to take my crops, eh. \u2026This trading for years has been taking
      quite a toll on me."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Sigh
    nextNodeID: Empathy
    text: "Ever since Poseidon flooded Athens, our family has been struggling. Too
      much land has been damaged\u2026 Will it ever be recovered?"
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Empathy
    nextNodeID: Imokay
    text: "\u2026I\u2019m sorry for the trouble you are going through. Do you need
      me to help with anything?"
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Imokay
    nextNodeID: Suffer
    text: "Ah, forget \u2018bout it. You gotta also be one ye job. It\u2019s something
      us peasants have to pull through\u2026 "
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Suffer
    nextNodeID: Gone
    text: "It\u2019s always us who suffer from the acts of the higher ups, eh boy.
      Let me guide you to the wheat farm here. "
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Gone
    nextNodeID: Help?
    text: "The lock pick is broken, what? The package is gone! This can\u2019t be
      true!"
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Help?
    nextNodeID: Panick
    text: "(What should I do? What can I do to help Lydos?) Please don\u2019t worry.
      I can help."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Panick
    nextNodeID: Responsibility
    text: "You can\u2019t! This village has no security. What do you think you can
      do?"
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Responsibility
    nextNodeID: Doubt
    text: "Please, calm down. I\u2019ll try my best, and I\u2019ll take responsibility
      if the crop has been lost. So do not worry."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 1
    id: Doubt
    nextNodeID: 
    text: "But why- \u2026okay. Go on, boy. I doubt it but\u2026 I could use your
      help."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Lydos
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  toggleFlagOnTalk: 1
  flag: StartWheatQuest
