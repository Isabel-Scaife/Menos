  m_Script: {fileID: 11500000, guid: 8cea624aa6e51a74d85663bcdeb0ee41, type: 3}
  m_Name: VY_OldLady
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  startingNodeID: 0
  nodes:
  - isEndpoint: 0
    id: 0
    nextNodeID: Yes
    text: "Oh, I\u2019ve never seen you around here. Would you have the time to spare
      this old lady? Young people nowadays are too busy to talk to me."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Yes
    nextNodeID: ThankYou
    text: "Of course, I\u2019d like to."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: ThankYou
    nextNodeID: Sadness
    text: Thank you. Come, sit down here.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Sadness
    nextNodeID: Limit
    text: "\u2026It has been a long time since my son has passed. He was a very sweet
      one, and also to his wife. Not long after, my daughter-in-law also got sick,
      and she passed away."
    choices: []
    updateSpeakerInfo: 0
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Limit
    nextNodeID: Bion
    text: I had to take care of my two young grandchildren myself, but with this
      age, I was barely able to work on a farm. The young one, Bion, is working all
      day to provide for us.
    choices: []
    updateSpeakerInfo: 0
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Bion
    nextNodeID: Flood
    text: "He would do anything for the people in the village, and it hurts me to
      see him do that. But he won\u2019t take no for an answer\u2026 because I can\u2019t
      work, and his sister is too young."
    choices: []
    updateSpeakerInfo: 0
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Flood
    nextNodeID: Favor
    text: "However, after the flood, there are less and less work for Bion as people
      couldn\u2019t afford additional workers on the field. I told him not to worry,
      but it probably does worry him\u2026"
    choices: []
    updateSpeakerInfo: 0
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: Favor
    nextNodeID: choices0
    text: "Would you do me one more favor and bring him his lunch? I made it for
      him, but he left it, telling me that I should have it instead. He doesn\u2019t
      have work today, so he will be at the town center."
    choices: []
    updateSpeakerInfo: 1
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 0
    id: choices0
    nextNodeID: 
    text: 
    choices:
    - text: "I will. Don\u2019t worry."
      nextNodeID: End
      outcome:
        flagsToSet: []
        statChanges: 
        questsID: []
    - text: "As a delivery man, I\u2019d be happy to fulfill your request."
      nextNodeID: End
      outcome:
        flagsToSet: []
        statChanges: 
        questsID: []
    updateSpeakerInfo: 1
    speakerName: Ceryx
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
  - isEndpoint: 1
    id: End
    nextNodeID: 
    text: Thank you dear. May gods bless you.
    choices: []
    updateSpeakerInfo: 1
    speakerName: Aikaterini
    leftSprite: {fileID: 21300000, guid: 65d50137d10f0444c82703dc57f2fdd2, type: 3}
    rightSprite: {fileID: 7150802143551903488, guid: bee79c88ac91e9e46bbb3243aa07f3f0, type: 3}
